{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "CotizaMe",
    "source": "front/src/app/globals.css",
    "canonicalDoc": "planing/ui-spec.md",
    "version": "1.0",
    "date": "2026-06-03",
    "bodyBaselineDecision": "15px (0.9375rem) en body global; escala nominal basada en 16px — ver ui-spec §2"
  },
  "typography": {
    "fontFamily": {
      "display": { "value": "Plus Jakarta Sans, sans-serif" },
      "body": { "value": "DM Sans, sans-serif" },
      "mono": { "value": "DM Mono, monospace" }
    },
    "fontSize": {
      "display": { "value": "2.4375rem", "px": 39, "tailwind": "text-display" },
      "h1": {
        "value": "1.9375rem",
        "px": 31,
        "fluid": "clamp(1.75rem, 4vw, 1.9375rem)",
        "tailwind": "text-h1"
      },
      "h2": {
        "value": "1.5625rem",
        "px": 25,
        "fluid": "clamp(1.375rem, 3vw, 1.5625rem)",
        "tailwind": "text-h2"
      },
      "h3": {
        "value": "1.3125rem",
        "px": 21,
        "fluid": "clamp(1.125rem, 2.5vw, 1.3125rem)",
        "tailwind": "text-h3"
      },
      "bodyLg": { "value": "1.125rem", "px": 18, "tailwind": "text-body-lg" },
      "body": { "value": "1rem", "px": 16, "tailwind": "text-body" },
      "bodySm": {
        "value": "0.9375rem",
        "px": 15,
        "tailwind": "text-body-sm",
        "note": "Actual body default en globals.css"
      },
      "label": { "value": "0.875rem", "px": 14, "tailwind": "text-label" },
      "meta": { "value": "0.8125rem", "px": 13, "tailwind": "text-meta" },
      "overline": { "value": "0.75rem", "px": 12, "tailwind": "text-overline" }
    },
    "fontWeight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semi": 600,
      "bold": 700,
      "extra": 800
    },
    "lineHeight": {
      "tight": 1.1,
      "snug": 1.2,
      "normal": 1.25,
      "h": 1.3,
      "body": 1.5,
      "relaxed": 1.6
    },
    "letterSpacing": {
      "tighter": "-0.03em",
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.01em",
      "wider": "0.05em",
      "widest": "0.1em"
    }
  }
}
